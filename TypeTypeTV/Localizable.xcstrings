        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softwaredecoding ausdrücklich erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow software decoding"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
