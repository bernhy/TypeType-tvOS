    "settings.playbackHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste passende Hardwarequalität auswählen und Softwaredecoding nur bei Bedarf freigeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the best hardware quality; allow software decoding only when needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la meilleure qualité matérielle ; activez le décodage logiciel si nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la mejor calidad de hardware; activa la decodificación por software solo si es necesario."
          }
        }
      }
    },
    "settings.allowSoftware": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softwaredecoding ausdrücklich erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow software decoding"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le décodage logiciel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir decodificación por software"
          }
        }
      }
    },
    "settings.softwareWarning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig AUS. Nicht hardwarekompatible Codecs werden dadurch nicht automatisch gewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF by default. Software-only codecs are never selected automatically."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les codecs non pris en charge par le matériel ne sont jamais sélectionnés automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Nunca se seleccionan automáticamente los códecs no compatibles con el hardware."
          }
        }
      }
    },
