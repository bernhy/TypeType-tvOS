    "settings.bufferWarning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Vorladeziel ist keine garantierte Füllmenge. Der Cache enthält nur komprimierte Mediensegmente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The buffer target isn't guaranteed. Only compressed segments are cached."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le préchargement n'est pas garanti. Seuls les segments compressés sont mis en cache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La precarga no está garantizada. Solo se almacenan segmentos comprimidos."
          }
        }
      }
    },
