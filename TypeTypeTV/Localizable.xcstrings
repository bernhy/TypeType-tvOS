    "settings.languageNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deutsch ist voreingestellt. „Systemsprache“ folgt der Sprache deines Apple TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "German is the default. “System language” follows your Apple TV settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allemand est la langue par défaut. « Langue du système » suit votre Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alemán es el idioma predeterminado. « Idioma del sistema » sigue tu Apple TV."
          }
