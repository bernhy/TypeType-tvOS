      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätespezifische VideoToolbox-Erkennung. Profile, HDR und Framerates erfordern zusätzliche Tests."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VideoToolbox capabilities vary by device. Profiles, HDR and frame rates need testing."
