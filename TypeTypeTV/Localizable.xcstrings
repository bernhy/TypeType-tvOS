    "settings.contentVisibilityNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbarkeit von Inhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content visibility"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilité du contenu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilidad del contenido"
          }
        }
      }
    },
    "settings.contentVisibilityNoteHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Inhalte bleiben in der Bibliothek erhalten. Alte Wiedergabepositionen sind auch bei deaktivierter Verlaufsaufzeichnung weiter sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden content stays in the library. Existing playback positions remain visible when history recording is off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu masqué reste dans la bibliothèque. Les positions enregistrées restent visibles lorsque l’historique est désactivé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido oculto permanece en la biblioteca. Las posiciones guardadas siguen visibles con el historial desactivado."
          }
        }
      }
    },
    "settings.explain.recommendations": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt persönliche Videoempfehlungen auf der Startseite. Ausblenden entfernt nur diesen Bereich; deine Abonnements, Favoriten und gespeicherten Videos bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows personalized video recommendations on Home. Turning this off only hides that section; subscriptions, favorites, and saved videos remain available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des vidéos recommandées sur l’accueil. La désactivation masque uniquement cette rubrique ; les abonnements, favoris et vidéos enregistrées restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra recomendaciones personalizadas en Inicio. Al desactivarlo solo se oculta esa sección; las suscripciones, los favoritos y los vídeos guardados permanecen disponibles."
          }
        }
      }
    },
    "settings.explain.continueWatching": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt zuletzt angesehene Videos auf der Startseite. Ausblenden löscht weder den bestehenden Verlauf noch gespeicherte Wiedergabepositionen. Der Verlauf bleibt in der Bibliothek verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows recently watched videos on Home. Hiding this section does not delete existing history or saved playback positions. History remains available in Library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les vidéos regardées récemment sur l’accueil. Masquer cette rubrique ne supprime ni l’historique existant ni les positions enregistrées, qui restent dans la bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los vídeos vistos recientemente en Inicio. Ocultar esta sección no borra el historial existente ni las posiciones guardadas; siguen en la biblioteca."
          }
        }
      }
    },
    "settings.explain.relatedVideos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt unter der Videobeschreibung oder den Kommentaren passende weitere Videos. Beim Ausschalten verschwindet nur diese Empfehlungsliste; die Wiedergabe bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows related videos beneath the description or comments on the video details page. Turning this off only hides these recommendations; playback is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des vidéos similaires sous la description ou les commentaires. La désactivation masque ces recommandations sans modifier la lecture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra vídeos relacionados debajo de la descripción o los comentarios. Al desactivarlo se ocultan esas recomendaciones sin modificar la reproducción."
          }
        }
      }
    },
    "settings.explain.endScreens": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert YouTube-Endbildschirm-Elemente am Ende eines Videos. Der tvOS-Player zeigt solche Elemente derzeit noch nicht an; dieser Schalter hat deshalb momentan keine sichtbare Wirkung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls YouTube end-screen elements at the end of videos. The tvOS player does not currently display these elements, so this setting has no visible effect yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle les éléments de fin des vidéos YouTube. Le lecteur tvOS ne les affiche pas encore ; ce réglage n’a donc pas d’effet visible pour l’instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla los elementos finales de los vídeos de YouTube. El reproductor de tvOS todavía no los muestra, así que este ajuste aún no tiene efecto visible."
          }
        }
      }
    },
    "settings.explain.subscriptionLiveStreams": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet laufende Livestreams aus dem Neuigkeiten-Feed deiner Abonnements aus. In der direkten Kanalansicht und in deiner Bibliothek bleiben sie erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides live broadcasts from the subscriptions feed. They can still be opened directly from their channel or your library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les diffusions en direct du fil d’abonnements. Elles restent accessibles dans leur chaîne ou dans la bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las emisiones en directo del feed de suscripciones. Siguen siendo accesibles en su canal o en la biblioteca."
          }
        }
      }
    },
    "settings.explain.membersOnlyContent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet als „Nur für Mitglieder“ gekennzeichnete Videos aus den Entdeckungsansichten aus. Videos ohne diese Kennzeichnung können weiterhin erscheinen; gespeicherte Bibliothekseinträge werden nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides videos marked as members-only from discovery screens. Videos without that metadata may still appear; saved library entries are not deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les vidéos marquées « réservées aux membres » dans les vues de découverte. Les vidéos sans cette indication peuvent rester visibles ; la bibliothèque n’est pas effacée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta de las vistas de descubrimiento los vídeos marcados como exclusivos para miembros. Los que no tengan esa información pueden seguir apareciendo; la biblioteca no se borra."
          }
        }
      }
    },
    "settings.explain.shorts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Shorts in Suchergebnissen, Empfehlungen und Kanalübersichten aus und versteckt den Shorts-Reiter. Bereits gespeicherte Videos bleiben in deiner Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides Shorts from search, recommendations, and channel lists, and hides the Shorts tab. Videos already saved remain in your library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les Shorts dans la recherche, les recommandations et les chaînes, ainsi que l’onglet Shorts. Les vidéos déjà enregistrées restent dans la bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta Shorts en búsquedas, recomendaciones y canales, así como la pestaña Shorts. Los vídeos guardados permanecen en la biblioteca."
          }
        }
      }
    },
    "settings.explain.comments": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt auf der Videodetailseite den Reiter „Kommentare“ mit Antworten, Bildern und verfügbaren Sprachantworten. Ausschalten versteckt den Reiter; es löscht keine Kommentare auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the Comments tab on video details, including replies, images, and available voice replies. Turning this off hides the tab; it does not delete comments on the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’onglet Commentaires sur la fiche vidéo, avec réponses, images et réponses vocales disponibles. Le désactiver masque l’onglet sans supprimer de commentaires du serveur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la pestaña Comentarios en los detalles del vídeo, con respuestas, imágenes y respuestas de voz disponibles. Al desactivarlo se oculta la pestaña, pero no se borran comentarios del servidor."
          }
        }
      }
    },
    "settings.explain.watchHistory": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob NEUE Wiedergaben und Abspielpositionen gespeichert werden. Aus: Es werden keine neuen Verlaufseinträge oder Fortschritte geschrieben. Bereits gespeicherter Verlauf und alte Positionen bleiben sichtbar; du kannst weiterhin von diesen Positionen fortsetzen. Beim Videostart erscheint ein Hinweis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls whether NEW plays and playback positions are saved. Off: no new history entries or progress updates are written. Existing history and saved positions remain visible and can still be used to resume. A notice appears when playback starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine si les NOUVELLES lectures et positions sont enregistrées. Désactivé : aucune nouvelle entrée ni mise à jour de progression. L’historique et les positions déjà enregistrés restent visibles et utilisables pour reprendre la lecture. Un avis apparaît au démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si se guardan NUEVAS reproducciones y posiciones. Desactivado: no se escriben nuevas entradas ni avances. El historial y las posiciones ya guardados permanecen visibles y sirven para reanudar. Se muestra un aviso al iniciar la reproducción."
          }
        }
      }
    },
