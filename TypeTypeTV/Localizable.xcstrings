    "accounts.inactiveHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Anmeldungen früherer Server. Ein nicht verbundener Server oder abgelaufenes Access-Token bedeutet nicht, dass die Anmeldung ungültig ist. Prüfen und Löschen erfolgen nur auf Wunsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logins from previously used servers. An offline server or expired access token does not necessarily mean the login is invalid. Checking and deletion are optional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexions de serveurs précédents. Un serveur hors ligne ou un jeton expiré ne signifie pas nécessairement une connexion invalide. Vérification et suppression sur demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de servidores anteriores. Un servidor sin conexión o un token caducado no significa necesariamente una sesión inválida. Comprobación y eliminación opcionales."
          }
        }
      }
    },
