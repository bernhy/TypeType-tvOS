            "value": "HTTPS: Unbekannte Zertifikate werden erst nach Fingerabdruckprüfung bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS: Untrusted certificates require explicit fingerprint verification."
