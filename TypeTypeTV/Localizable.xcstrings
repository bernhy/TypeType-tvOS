    "channels.notSupportedByServer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kanal-Funktion ist auf deiner TypeType-Instanz gerade nicht erreichbar. Bitte die installierte Serverversion und gegebenenfalls den Reverse-Proxy prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This channel feature is not available on your TypeType instance right now. Check the installed server version and, if applicable, the reverse proxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonction de chaîne n’est actuellement pas accessible sur votre instance TypeType. Vérifiez la version du serveur et, le cas échéant, le proxy inverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función del canal no está disponible en tu instancia de TypeType en este momento. Comprueba la versión del servidor y, si procede, el proxy inverso."
          }
        }
      }
    },
