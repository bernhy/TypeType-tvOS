    "certificate.warning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche den Fingerabdruck auf einem vertrauenswürdigen Weg mit deinem Server. Bestätigen speichert NUR genau dieses Zertifikat für diese Serveradresse. Bei einem Zertifikatswechsel wird erneut gefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare this fingerprint with your server using a trusted channel. Approval saves only this certificate for this server. Changes need a new confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez cette empreinte avec votre serveur via un canal sûr. Seul ce certificat sera approuvé pour ce serveur. Les changements exigeront une nouvelle validation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la huella con tu servidor por un canal seguro. La aprobación guarda solo este certificado para este servidor. Los cambios requerirán confirmación."
          }
        }
      }
    },
