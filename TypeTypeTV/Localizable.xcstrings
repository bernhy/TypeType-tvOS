    "settings.playerNoticeHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Meldungen können gleichzeitig angezeigt werden. Neue erscheinen oben, ältere rücken nach unten. Jede verschwindet nach ihrer eigenen Anzeigedauer. SponsorBlock bleibt separat bedienbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple notices may appear at once. New notices appear on top, older ones move down and each expires independently. SponsorBlock controls remain available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs notifications peuvent apparaître en même temps. Les nouvelles sont en haut, les anciennes descendent et chacune disparaît séparément. SponsorBlock reste accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden aparecer varios avisos a la vez. Los nuevos se muestran arriba, los anteriores bajan y cada uno desaparece por separado. SponsorBlock sigue disponible."
          }
        }
      }
    },
