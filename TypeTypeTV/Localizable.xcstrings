    "settings.blockedKeywordHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Videos aus, deren Titel das Schlüsselwort oder die Wortfolge enthält (Groß-/Kleinschreibung ist egal). Kanalnamen werden nicht gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides videos whose titles contain the word or phrase (case-insensitive). Channel names are not blocked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les vidéos dont le titre contient le mot ou l’expression (sans distinction de casse). Les noms de chaînes ne sont pas bloqués."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta vídeos cuyo título contiene la palabra o frase (sin distinguir mayúsculas). No bloquea nombres de canales."
          }
        }
      }
    },
