    "settings.remoteHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch zeigt die Statusleiste. Links/rechts springt, Play/Pause steuert die Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch shows controls. Left/right seeks; Play/Pause controls playback."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le toucher affiche les commandes. Gauche/droite avance ou recule ; Lecture/Pause gère la lecture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar muestra los controles. Izquierda/derecha salta; Reproducir/Pausa controla el vídeo."
          }
        }
      }
    },
