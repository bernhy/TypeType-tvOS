    "accounts.inactiveDeleteHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle auf diesem Apple TV gespeicherten Anmeldedaten für %1$@ werden entfernt. Die Konten auf dem Server bleiben bestehen. Der derzeit verbundene Server wird nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sign-in data saved on this Apple TV for %1$@ will be removed. Server accounts will remain. The connected server will not be changed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les données de connexion enregistrées sur cette Apple TV pour %1$@ seront supprimées. Les comptes serveur seront conservés. Le serveur actuel ne sera pas modifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los datos de inicio de sesión guardados en este Apple TV para %1$@. Las cuentas del servidor seguirán existiendo. El servidor conectado no cambiará."
          }
        }
      }
    },
