    "settings.languageHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache dieser App. Weitere Übersetzungen können als Sprachpakete ergänzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the language of this app. Additional translations can be added as language resources."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue de cette app. D'autres traductions peuvent être ajoutées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma de la aplicación. Se pueden añadir más traducciones."
          }
        }
      }
    },
