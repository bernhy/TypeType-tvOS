    "settings.bufferHelp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großer Cache auf deinem Apple TV. Der Server kann kleinere Segmentfenster liefern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large local cache on your Apple TV. The server may provide smaller segment windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grand cache local sur votre Apple TV. Le serveur peut fournir des fenêtres plus petites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gran caché local en tu Apple TV. El servidor puede enviar ventanas más pequeñas."
