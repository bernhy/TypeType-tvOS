    "setup.insecureWarning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP ist nur für lokale Adressen erlaubt. Anmeldung und Daten werden dabei unverschlüsselt übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP is restricted to local servers. Your sign-in and data are not encrypted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP est réservé aux serveurs locaux. L'authentification et les données ne sont pas chiffrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP solo permite servidores locales. Los datos y el inicio de sesión no están cifrados."
          }
        }
      }
    },
